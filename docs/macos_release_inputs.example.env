# Rift Road macOS release input template
#
# Do not commit real values in this file or in any copied `.env` file.
# Keep local values in an ignored `.env` or in your shell profile.
#
# Usage:
#   cp docs/macos_release_inputs.example.env .env
#   edit .env with local values
#   set -a; source .env; set +a
#   bash scripts/check_macos_signing_env.sh
#   bash scripts/sign_notarize_macos.sh

export RIFT_ROAD_APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
export RIFT_ROAD_DEVELOPER_ID_APPLICATION="Developer ID Application: YOUR_NAME_OR_ORG (YOUR_APPLE_TEAM_ID)"
export RIFT_ROAD_NOTARY_KEYCHAIN_PROFILE="rift-road-notary-profile"
